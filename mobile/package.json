{
  "name": "@school-bus-tracking/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "verify:sdk": "node scripts/verify-expo-sdk.mjs",
    "prestart": "npm run verify:sdk",
    "start": "node scripts/expo-start.mjs",
    "start:go": "node scripts/expo-start.mjs",
    "start:tunnel": "node scripts/expo-start.mjs --tunnel",
    "start:dev-client": "expo start --dev-client",
    "preandroid": "npm run verify:sdk",
    "android": "node scripts/expo-start.mjs --android",
    "preios": "npm run verify:sdk",
    "ios": "node scripts/expo-start.mjs --ios",
    "web": "expo start --web",
    "prebuild": "npm run verify:sdk && npm run verify:firebase && expo prebuild",
    "preandroid:build": "npm run verify:sdk && npm run verify:firebase",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "doctor": "expo-doctor",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/run-specs.mjs mobile",
    "test:offline-sim": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings --test src/features/crew/offline/offline-sync.sim.spec.ts",
    "test:push-sim": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings --import ./scripts/test-loaders/native-stubs.loader.mjs --test src/features/notifications/push-lifecycle.sim.spec.ts",
    "test:feedback-sim": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings --import ./scripts/test-loaders/native-stubs.loader.mjs --test src/features/crew/crew-feedback.sim.spec.ts",
    "test:sim": "npm run test:offline-sim && npm run test:push-sim && npm run test:feedback-sim && npm run test:tracking-sim",
    "clean": "rimraf .expo dist",
    "verify:firebase": "node scripts/verify-firebase-config.mjs",
    "test:tracking-sim": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings --import ./scripts/test-loaders/native-stubs.loader.mjs --test src/features/crew/tracking-recovery.sim.spec.ts src/features/crew/tracking-resume.sim.spec.ts",
    "test:scope": "node ../scripts/run-specs.mjs mobile --filter",
    "test:changed": "node ../scripts/run-specs.mjs mobile --changed"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@school-bus-tracking/api-client": "*",
    "@school-bus-tracking/config": "*",
    "@school-bus-tracking/design-tokens": "*",
    "@school-bus-tracking/map-assets": "*",
    "@school-bus-tracking/shared-types": "*",
    "@school-bus-tracking/validation": "*",
    "@types/geojson": "^7946.0.16",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native/virtualized-lists": "0.86.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.11",
    "metro-runtime": "~0.84.5",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3"
  }
}
