# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# The unified Next.js server serves the web UI *and* the API from PORT below,
# so the browser origin is the same host:port. CsrfGuard rejects state-changing
# requests whose Origin is not listed here, so this must match how you open the
# app. Comma-separate extra origins (e.g. a LAN address for the mobile app).
CORS_ORIGIN=http://localhost:3001
# Public origin used to build absolute links the server sends OUT — today the
# password-reset link in the email ({APP_URL}/reset-password?token=...).
# Optional: when unset, the first CORS_ORIGIN entry is used, which is already
# "the origin a browser reaches this app on". Set it explicitly when the app
# sits behind a proxy whose public URL differs from CORS_ORIGIN.
APP_URL=https://kidbus.onrender.com

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_bus_tracking
# Separate database used by the automated test suite (NODE_ENV=test)
DB_NAME_TEST=school_bus_tracking_test
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Local development may use false. PRODUCTION REQUIRES DB_SSL=true: the server
# refuses to start with NODE_ENV=production unless DB_SSL is explicitly "true"
# and DB_HOST/DB_NAME/DB_USERNAME/DB_PASSWORD are all set (no dev defaults).
DB_SSL=false
DB_LOGGING=false
# Pool sized for the dashboard's parallel burst (5 concurrent API calls x
# 4-7 internal queries each) plus warm standby connections.
DB_POOL_MAX=30
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# The API must connect to Sequelize so User/RefreshToken models are initialized.
# Keep this true for start/start:dev/start:prod. DB_AUTO_CONNECT=false is honored
# only by stubbed tests/smoke scripts (or with DB_ALLOW_NO_CONNECT=true).
DB_AUTO_CONNECT=true
DB_ALLOW_NO_CONNECT=false

# ==========================================
# Authentication (JWT & Sessions)
# ==========================================
# REQUIRED in production. Use a long random value, e.g. `openssl rand -hex 64`.
JWT_SECRET=
# Access token lifetime (ms-compatible format, e.g. 15m, 1h)
JWT_EXPIRES_IN=15m
# Refresh token lifetime (ms-compatible format, e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d
# Name of the httpOnly cookie carrying the refresh token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# ==========================================
# Task 22 — Dynamic ETA (approximate, GPS-based)
# ==========================================
# Speed assumed when the crew device reports no usable speed (km/h).
ETA_FALLBACK_SPEED_KMH=25
# Operational band the effective speed is clamped into (km/h).
ETA_MIN_SPEED_KMH=5
ETA_MAX_SPEED_KMH=90

# ==========================================
# Stop-arrival detection (see docs/notification-hardening-handoff.md)
# ==========================================
# Runtime floor on every stop's EFFECTIVE geofence radius, in metres. The
# stored radius stays the admin's intent; evaluation floors it at this value
# everywhere the radius participates (inside-evidence, the per-stop accuracy
# gate, the departure margin, candidate selection). 50 keeps legacy 10–30 m
# stops working as real circles: a phone reporting 10–30 m accuracy parks
# INSIDE a 50 m zone and records, where the old stored-radius match demanded
# an almost exact coordinate hit.
ARRIVAL_MIN_EFFECTIVE_RADIUS_METERS=25
# Minimum distance between the fix that recorded the previous stop and the
# fix recording the next one. DISABLED (0) by default: the gate is
# route-blind, and on routes whose consecutive stops sit 20–40 m apart (legal
# at the legacy 10 m minimum radius) it silently dropped every close stop the
# bus actually served. The anti-cascade load is carried by the (geometry
# aware) departure gate, the 30 s cooldown, the 10 s dwell and the
# consecutive-fix count. Set it only if your fleet wants an absolute
# movement floor between recordings.
# ARRIVAL_MIN_INTERSTOP_DISTANCE_METERS=0

# ==========================================
# Security
# ==========================================
SECURITY_IS_PRODUCTION=false
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=15552000
SECURITY_CSRF_ENABLED=true

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_REFRESH_LIMIT=10
RATE_LIMIT_READ_HEAVY_LIMIT=100
# Store backing the counters. `memory` (default) is process-local and correct
# for the supported single-instance deployment; `redis` fails fast (not
# implemented in this phase). See docs/security.md before scaling horizontally.
RATE_LIMIT_STORE=memory
# Only enable behind a trusted reverse proxy/load balancer, otherwise clients
# can spoof X-Forwarded-For and dodge the limiter.
RATE_LIMIT_TRUST_PROXY=false

# ==========================================
# Data Retention (days)
# ==========================================
# GPS trip locations — can grow quickly
LOCATION_RETENTION_DAYS=90
# Notifications
NOTIFICATION_RETENTION_DAYS=180
# Expired refresh tokens
REFRESH_TOKEN_RETENTION_DAYS=30
# Audit logs
AUDIT_LOG_RETENTION_DAYS=365
# Resolved/cancelled emergency events
EMERGENCY_RETENTION_DAYS=730
# Expired idempotency keys
IDEMPOTENCY_KEY_RETENTION_DAYS=7
# ------------------------------------------
# Marketing retention (Hardening 5B). These policies run in the SAME
# retention worker pass as the ones above — there is no second timer.
#
# They anonymize more than they delete, on purpose: campaign counters,
# consent evidence and suppression instructions have to outlive the personal
# data they were derived from. Suppressions are NEVER aged out: an
# unsubscribe, a hard bounce and a complaint are permanent instructions.
#
# Per-event analytics rows (sends, clicks, unsubscribes, bounces). Campaign
# counters live on the campaign row and survive this.
MARKETING_EVENT_RETENTION_DAYS=365
# Demo leads. After this the contact fields are anonymized in place; the
# consent record, the status history and the timeline survive.
MARKETING_LEAD_RETENTION_DAYS=730
# Campaign recipient PII. Only terminal rows are touched — a PENDING,
# PROCESSING or RETRYING recipient keeps the address it is about to receive.
MARKETING_RECIPIENT_PII_RETENTION_DAYS=180
# Terminal (SENT/FAILED/EXPIRED) admin-notification jobs. Outstanding jobs
# are never deleted by retention.
MARKETING_NOTIFICATION_JOB_RETENTION_DAYS=90
# Stored provider feedback events (digest + bounded metadata only).
MARKETING_PROVIDER_EVENT_RETENTION_DAYS=180
# ------------------------------------------
# Retention worker cadence (runs inside the API server process).
# RETENTION_ENABLED=false disables scheduling entirely.
RETENTION_ENABLED=true
# One cleanup pass every 6 hours; first pass 30s after boot.
RETENTION_INTERVAL_MS=21600000
RETENTION_INITIAL_DELAY_MS=30000

# ==========================================
# Subscription
# ==========================================
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# ==========================================
# WebSocket session governance
# ==========================================
# Periodic sweep that disconnects sockets whose access token expired, whose
# account was deactivated, or whose school was deactivated. Handshake JWT
# verification is unaffected and always on.
WEBSOCKET_SESSION_REVALIDATION_ENABLED=true
WEBSOCKET_SESSION_REVALIDATION_INTERVAL_MS=300000

# ==========================================
# Idempotency
# ==========================================
IDEMPOTENCY_TTL_HOURS=24

# ==========================================
# FCM Push Notifications (Firebase Cloud Messaging)
# ==========================================
# Leave both EMPTY to keep the NoOpPushProvider (local dev / CI without
# credentials). When FIREBASE_SERVICE_ACCOUNT_JSON is set, the API delivers
# real OS-level push via firebase-admin — FCM is free.
#
# FIREBASE_PROJECT_ID — the Firebase project id (matches the service
# account's project_id).
FIREBASE_PROJECT_ID=
# Full Firebase service-account JSON on ONE line (the whole object, e.g.
# {"type":"service_account","project_id":"...",...}). NEVER commit real
# values; the API only reads it and never logs or echoes it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================================
# Notification Providers (future)
# ==========================================
# ==========================================
# Map (OpenFreeMap — no key, no billing)
# ==========================================
# Optional self-hosted OpenFreeMap style URL. Must be https:// and a style JSON.
# When unset, web/src/features/map/map-style.ts falls back to
# https://tiles.openfreemap.org/styles/liberty (public instance).
# Same contract as mobile's EXPO_PUBLIC_MAP_STYLE_URL.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.example.com/styles/liberty

# ==========================================
# Email Delivery (SMTP — free, no paid API)
# ==========================================
# Outbound email rail, shared by every mail feature: the SCHOOL_ADMIN
# self-service password-reset link (POST /api/v1/auth/forgot-password) and,
# from the marketing phase on, Super Admin notifications and marketing
# campaign delivery (see docs/marketing-communications.md).
#
# EMAIL_PROVIDER=smtp *plus all five* SMTP settings below selects real
# delivery. If any of them is missing the app logs a warning (an error in
# production) and falls back to NoOpEmailProvider, which logs what it WOULD
# have sent and reports success — so local dev, `npm test` and CI need no
# relay and no credentials, and a half-configured relay can never fail
# silently at send time.
#
# Any plain SMTP server works: a Google Workspace / Microsoft 365 relay, a
# self-hosted Postfix, an ISP smarthost. For the Gmail relay use an app
# password, never the account's own password.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE — true for implicit TLS (port 465), false for STARTTLS (587).
# Optional: defaults to true when SMTP_PORT is 465 and false otherwise.
SMTP_SECURE=false
SMTP_USER=
# SMTP password / app password. NEVER commit a real value; the server reads
# it once and never logs or echoes it.
SMTP_PASS=
# Header sender of every message. A display name is allowed.
EMAIL_FROM=Zero Mile Systems <zeromilesystems@gmail.com>
EMAIL_REPLY_TO=zeromilesystems@gmail.com

# How long a password-reset link stays valid, in milliseconds. Optional;
# defaults to 45 minutes and is CLAMPED to 30-60 minutes, so a mistyped value
# degrades to a safe lifetime instead of creating a standing key. The email
# always states the number the server actually enforces.
# PASSWORD_RESET_TTL_MS=2700000

# Public reset endpoints are rate limited separately from the admin-initiated
# reset (stricter, because they are unauthenticated): per IP, and per
# school+email identity. Defaults: 5 requests / 15 min per IP, 3 / hour per
# identity.
# RATE_LIMIT_PASSWORD_RESET_PUBLIC_LIMIT=5
# RATE_LIMIT_PASSWORD_RESET_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PASSWORD_RESET_PUBLIC_IDENTITY_LIMIT=3
# RATE_LIMIT_PASSWORD_RESET_PUBLIC_IDENTITY_WINDOW_MS=3600000

# ==========================================
# Marketing Communications (Super Admin)
# ==========================================
# See docs/marketing-communications.md before changing any of these.
#
# Where OPERATIONAL mail goes: test emails, demo lead notifications,
# campaign failure alerts and system alerts. Comma-separated. Campaign
# emails themselves NEVER go here — they go only to the school recipients
# produced by the server-side audience snapshot.
MARKETING_ADMIN_EMAILS=zeromilesystems@gmail.com
#
# The CLOSED allowlist a test send may target. The browser can never supply
# an arbitrary test address; a test send that does not resolve to one of
# these is rejected by the server.
MARKETING_TEST_RECIPIENTS=zeromilesystems@gmail.com
#
# Background campaign worker (runs inside the API server process, like the
# retention and notification-outbox workers). MARKETING_WORKER_ENABLED=false
# disables scheduling entirely.
MARKETING_WORKER_ENABLED=true
# Wake every minute; campaigns retain their own scheduled_at timestamp.
MARKETING_WORKER_INTERVAL_MS=60000
MARKETING_WORKER_INITIAL_DELAY_MS=30000
# Initial durable settings (subsequent Super Admin changes live in PostgreSQL).
MARKETING_DAILY_SEND_CAP=500
MARKETING_DELIVERY_TIMEZONE=UTC
# How many recipients one sweep may claim. MARKETING_BATCH_SIZE is the
# canonical name; MARKETING_WORKER_BATCH_SIZE stays accepted as an alias.
# MARKETING_BATCH_SIZE=25
#
# Recipient delivery policy: bounded attempts with exponential backoff and
# jitter. MARKETING_MAX_ATTEMPTS / MARKETING_RETRY_BASE_MS are the canonical
# names; the MARKETING_DELIVERY_* spellings remain accepted as aliases.
# MARKETING_MAX_ATTEMPTS=5
# MARKETING_RETRY_BASE_MS=60000
#
# Pacing. A burst of thousands of messages is what makes mail providers start
# rejecting a sending domain, so delivery is deliberately slow: at most
# MARKETING_RATE_PER_MINUTE messages a minute, at most MARKETING_CONCURRENCY
# in flight at once, with a small randomized gap between sends.
# MARKETING_RATE_PER_MINUTE=60
# MARKETING_CONCURRENCY=3
# MARKETING_SEND_DELAY_MS=250
# MARKETING_SEND_JITTER_MS=250
#
# A recipient still unsent this long after its campaign started is expired
# rather than delivered — nobody wants a "reminder" three days late.
# MARKETING_EXPIRY_MS=259200000
#
# Lease held on a claimed recipient. If a worker crashes mid-send, the row
# becomes claimable again once the lease expires; it is never sent twice by
# two live workers because claiming uses FOR UPDATE SKIP LOCKED.
# MARKETING_LEASE_MS=120000
#
# The public "Request a Demo" form (POST /public/marketing/demo-request) is
# rate limited separately and more strictly than the click/unsubscribe
# endpoints: per IP, and per (hashed) submitted email identity. No raw IP is
# ever stored. Defaults: 5 requests / 15 min per IP, 3 / hour per identity.
# RATE_LIMIT_MARKETING_DEMO_REQUEST_LIMIT=5
# RATE_LIMIT_MARKETING_DEMO_REQUEST_WINDOW_MS=900000
# RATE_LIMIT_DEMO_REQUEST_IDENTITY_LIMIT=3
# RATE_LIMIT_DEMO_REQUEST_IDENTITY_WINDOW_MS=3600000
#
# ------------------------------------------------------------------
# Durable admin-notification queue (Hardening 5B)
# ------------------------------------------------------------------
# A demo request writes the lead AND a marketing_notification_jobs row in one
# transaction, then returns immediately. The worker (same tick as campaign
# delivery, notifications first) claims jobs with FOR UPDATE SKIP LOCKED
# under a lease, so a restart delays a notification instead of losing it and
# two workers never send it twice. Recipients come only from
# MARKETING_ADMIN_EMAILS; SMTP failure can never roll back the lead.
# MARKETING_NOTIFY_BATCH_SIZE=10
# MARKETING_NOTIFY_MAX_ATTEMPTS=5
# MARKETING_NOTIFY_RETRY_BASE_MS=60000
# After this age a job is EXPIRED rather than retried forever (24h).
# MARKETING_NOTIFY_EXPIRY_MS=86400000
# MARKETING_NOTIFY_LEASE_MS=120000
#
# ------------------------------------------------------------------
# Provider email-event webhook (Hardening 5B) — SECRET
# ------------------------------------------------------------------
# POST /api/v1/integrations/marketing/email-events accepts signed
# delivered / hard_bounce / soft_bounce / complaint events. The endpoint is
# CLOSED unless this secret is set (>= 16 chars): an unverified suppression
# endpoint would let anyone silence any address. Requests carry
# x-marketing-timestamp and x-marketing-signature (HMAC-SHA256 over
# "<timestamp>.<raw body>", +/- 5 minutes, duplicate event ids ignored).
#
# BE HONEST ABOUT WHAT THIS DOES TODAY: plain Gmail SMTP sends NO webhook.
# A delayed bounce or a spam complaint arrives as a message in the sending
# mailbox, not as an HTTP call. Until a real event source is configured, the
# working feedback loop is (a) the delivery worker's handling of immediate
# SMTP rejections and (b) the Super Admin suppression console at
# /admin/marketing/suppressions. Leave this empty if nothing signs events.
# Generate with: openssl rand -hex 32   (set it only in Render Environment)
# MARKETING_PROVIDER_WEBHOOK_SECRET=
#
# ------------------------------------------------------------------
# Click attribution signing key (Hardening 5B) — SECRET
# ------------------------------------------------------------------
# Signs the HttpOnly zms_ref cookie minted on a valid tracked click. The
# cookie carries a random nonce, an expiry and an HMAC tag; only sha256(nonce)
# is stored, so resolving a demo submission is ONE indexed lookup and a
# database leak yields no usable cookie. No email address appears in any
# tracking URL or cookie. Empty = signed attribution disabled (clicks fall
# back to the legacy opaque digest cookie, still resolved by index).
# Rotating the key invalidates outstanding cookies; it is read per request,
# so no restart is needed.
# Generate with: openssl rand -hex 32   (set it only in Render Environment)
# MARKETING_ATTRIBUTION_SECRET=

# ==========================================
# Notification Providers (future)
# ==========================================
# SMS_PROVIDER=noop
