{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src/server",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/server/**/*"],
  "exclude": ["src/server/**/*.spec.ts", "src/server/http/route-testing.ts", "src/server/http/test-server.ts"]
}
