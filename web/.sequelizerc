/**
 * Sequelize CLI configuration for the School Bus Tracking application.
 *
 * The schema is migration-driven: `sequelize.sync()` is never used.
 * All paths are TypeScript. `ts-node` is registered by
 * `scripts/sequelize-cli.js`, so always run commands via the `db:*` npm
 * scripts (e.g. `npm run db:migrate`) rather than the raw `sequelize` binary.
 */
const path = require('path');

module.exports = {
  config: path.resolve('src/server/config/sequelize-cli.config.ts'),
  'migrations-path': path.resolve('src/server/database/migrations'),
  'models-path': path.resolve('src/server/database/models'),
  'seeders-path': path.resolve('src/server/database/seeders'),
};
