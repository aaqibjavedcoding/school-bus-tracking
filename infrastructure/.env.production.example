# ============================================================================
# Single-instance production configuration for docker-compose.prod.yml
# ----------------------------------------------------------------------------
# Copy this file to `.env.production` IN THIS DIRECTORY and replace every
# CHANGE_ME value:
#
#   cp .env.production.example .env.production
#
# `.env.production` is git-ignored. Never commit it, paste real secrets into
# chat/tickets, or bake them into the image. The committed example ships
# placeholder values only.
#
# Used in two ways by docker compose:
#   * `--env-file .env.production` supplies the ${...} interpolation values
#     consumed by this compose file (e.g. the POSTGRES_* boot variables);
#   * the same file is passed to the `app` and `migrate` containers via
#     `env_file:` (application configuration).
# ============================================================================

# --- Public browser origin(s) of THIS deployment ---------------------------
# Comma-separated allowlist, no wildcard, no trailing slash. Production refuses
# to start with a missing or wildcarded CORS allowlist.
CORS_ORIGIN=https://app.example.com

# --- Database ---------------------------------------------------------------
# Initialised by the db container on first boot (data volume creation).
DB_NAME=school_bus_tracking
DB_USERNAME=postgres
# Strong password, e.g. openssl rand -base64 32. Quote it if it contains '#',
# spaces or shell metacharacters.
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# DB_HOST/DB_PORT/DB_SSL are pinned by docker-compose.prod.yml (db / 5432 /
# TLS on the internal Docker network).

# --- Authentication ---------------------------------------------------------
# REQUIRED in production; the server refuses to boot without it.
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_OPENSAL_RAND_HEX_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Container image / host binding ----------------------------------------
IMAGE_TAG=latest
# Host loopback port published by the app container (reverse proxy target).
APP_PORT=3001

# --- Connection pool (optional; defaults are single-instance sized) --------
DB_POOL_MAX=30
DB_POOL_MIN=5

# --- FCM push notifications -------------------------------------------------
# Leave EMPTY to run the no-op push provider (safe default). Real Firebase
# service-account JSON is supplied at deployment time via the actual
# .env.production (or the orchestrator's secret mechanism) and must never be
# committed. The API reads it once and never logs or echoes it.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Public application URL -------------------------------------------------
APP_URL=https://kidbus.onrender.com

# --- Road routing (self-hosted OSRM — free, no key) -------------------------
# Base URL of a RUNNING osrm-routed over a prebuilt graph (see
# infrastructure/README.md → "OSRM routing engine"). BLANK = road routing
# DISABLED: GET /routes/:id/geometry answers { status: "unavailable" } and the
# maps draw the dashed stop-to-stop line — the behaviour before this phase.
# The geometry is cached forever per stops-hash, so the engine does NOT need
# to run 24/7; a 512 MB Render free instance cannot host OSRM — run the engine
# on a small VM and point this at it, or backfill from the free GitHub runner
# (.github/workflows/osrm-backfill.yml) and keep only the cache here.
# The URL must never carry a key=/api_key= credential (the config refuses to
# boot on one) — OSRM is keyless by design.
ROUTING_SERVICE_URL=
ROUTING_TIMEOUT_MS=5000
ROUTING_MAX_REQUESTS_PER_SECOND=1

# --- SMTP email (credentials belong only in Render Environment settings) ----
# For Gmail, SMTP_PASS must be a Gmail App Password, never the normal account
# password. This Gmail sender has no custom DNS control for gmail.com; do not
# configure any invented or unverified custom-domain sender.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Zero Mile Systems <zeromilesystems@gmail.com>
EMAIL_REPLY_TO=zeromilesystems@gmail.com

# --- Durable marketing delivery --------------------------------------------
MARKETING_ADMIN_EMAILS=zeromilesystems@gmail.com
MARKETING_TEST_RECIPIENTS=zeromilesystems@gmail.com
MARKETING_WORKER_ENABLED=true
MARKETING_WORKER_INTERVAL_MS=60000
MARKETING_WORKER_INITIAL_DELAY_MS=30000
MARKETING_BATCH_SIZE=25
MARKETING_DAILY_SEND_CAP=500
MARKETING_RATE_PER_MINUTE=60
MARKETING_DELIVERY_TIMEZONE=UTC
MARKETING_CONCURRENCY=3
MARKETING_MAX_ATTEMPTS=5
MARKETING_RETRY_BASE_MS=60000
MARKETING_LEASE_MS=120000
# The daily cap is a local-calendar-day safety ceiling. The worker wakes every
# minute and automatically continues queued recipients on following days; it
# is not one large campaign run every 24 hours.

# --- Durable admin-notification queue (Hardening 5B) -----------------------
# The "new demo request" email is a marketing_notification_jobs row written in
# the same transaction as the lead, drained by the same worker tick as
# campaign delivery (notifications first). Restart-safe and duplicate-proof;
# recipients come only from MARKETING_ADMIN_EMAILS above.
MARKETING_NOTIFY_BATCH_SIZE=10
MARKETING_NOTIFY_MAX_ATTEMPTS=5
MARKETING_NOTIFY_RETRY_BASE_MS=60000
MARKETING_NOTIFY_EXPIRY_MS=86400000
MARKETING_NOTIFY_LEASE_MS=120000

# --- Marketing secrets (set ONLY in Render Environment, never in Git) ------
# Signed provider email-event ingest. The endpoint stays closed while this is
# empty. Honest note: Gmail SMTP does not call it — delayed bounces and spam
# complaints arrive in the sending mailbox and are recorded by hand at
# /admin/marketing/suppressions. Set this only when a real event source signs
# events. Generate: openssl rand -hex 32
MARKETING_PROVIDER_WEBHOOK_SECRET=
# Signing key of the HttpOnly zms_ref attribution cookie. Empty disables
# signed attribution (legacy digest cookies still resolve, by index).
# Generate: openssl rand -hex 32
MARKETING_ATTRIBUTION_SECRET=

# --- Marketing data retention ----------------------------------------------
# Run inside the existing retention worker pass. Suppressions are never aged
# out; leads and recipient PII are anonymized in place so consent evidence
# and campaign counters survive.
MARKETING_EVENT_RETENTION_DAYS=365
MARKETING_LEAD_RETENTION_DAYS=730
MARKETING_RECIPIENT_PII_RETENTION_DAYS=180
MARKETING_NOTIFICATION_JOB_RETENTION_DAYS=90
MARKETING_PROVIDER_EVENT_RETENTION_DAYS=180

# --- Sender domain caveat ---------------------------------------------------
# This deployment sends from a Gmail mailbox. SPF, DKIM and DMARC for
# gmail.com are Google's and cannot be configured here; deliverability
# therefore depends on Gmail's reputation, not on DNS records we control. Do
# NOT invent a custom-domain sender (for example updates@yourdomain.com):
# an unverified From address fails authentication and lands in spam.
