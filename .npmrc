# React Native 0.86 (Expo SDK 57) peers on react 19.2.3 while the web app
# (Next 14) pins react 18.3.1. The lockfile already carries that combination,
# so npm can only re-resolve the tree — e.g. when adding native mobile
# dependencies — with peer conflicts ignored. This is the standard setup for
# Expo monorepos that must keep two Reacts (web: 18, mobile: 19); Metro is
# pinned to the mobile copy in mobile/metro.config.js.
legacy-peer-deps=true
