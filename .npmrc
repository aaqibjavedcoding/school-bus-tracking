# React Native 0.74 (Expo SDK 51) peers on react 18.2.0 while the web app and
# the root workspace override pin react 18.3.1. The lockfile already carries
# that combination (react@18.3.1 + react-native@0.74.5), so npm can only
# re-resolve the tree — e.g. when adding native mobile dependencies — with
# peer conflicts ignored. This is the standard setup for Expo monorepos.
legacy-peer-deps=true
